DB_HOST=localhost
DB_PORT=5432
DB_NAME=memory
DB_USER=memory
# Required: generate a unique database password before starting Compose.
DB_PASSWORD=
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# Base URLs include /v1. Local servers may use an empty API key.
EMBEDDING_BASE_URL=http://localhost:8000/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=local-embedding-model
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=768
EMBEDDING_VERSION=1
EMBEDDING_TIMEOUT=30s
EMBEDDING_SEND_DIMENSIONS=false
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=
LLM_MODEL=local-chat-model
LLM_TIMEOUT=60s
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_JSON_MODE=true
MEMORY_LOG_CONTENT=false
CONSOLIDATION_SCHEDULE_ENABLED=false
CONSOLIDATION_ARCHIVE_ON_SCHEDULE=true
MEMORY_CONSOLIDATION_CRON=0 0 3 * * *

# Optional relevance gates, each in [0,1]. Zero disables the gate.
# Tune using your embedding model and real queries; scores are not probabilities.
MEMORY_RANKING_MINIMUM_SCORE=0
MEMORY_RANKING_MINIMUM_SEMANTIC_SCORE=0

# Optional: use the existing PostgreSQL server for integration tests, without Docker.
# Tests create/drop only their own random schema, but require vector enabled in public.
# TEST_DB_URL=jdbc:postgresql://localhost:5432/memory
# TEST_DB_USER=memory
# TEST_DB_PASSWORD=replace-with-your-local-database-password
